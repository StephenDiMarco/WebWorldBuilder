{% extends 'base.jinja' %}

{% block header %}
  <h1>{% block title %}Towns{% endblock %}</h1>
  <a class="action" href="{{ url_for('generator.create') }}">Generate New Town</a>
{% endblock %}

{% block content %}
  {% for town in towns %}
    <article>
       <header>
          <h1>{{ town['name'] }}</h1>
      </header>
      <p class="body">Town details to come</p>
    </article>
    {% if not loop.last %}
      <hr>
    {% endif %}
  {% endfor %}
{% endblock %}
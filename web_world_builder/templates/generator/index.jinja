{% extends 'base.jinja' %}

{% block header %}
  <h1>{% block title %}Towns{% endblock %}</h1>
  <a class="action" href="{{ url_for('generator.create') }}">{{font_awesome.render_icon("fa-solid fa-plus")}}</a>
{% endblock %}

{% block content %}
  {% for town in towns %}
    <article>
       <header class="icon-group">
          <h1>{{ town['name'] }}</h1>
          <a class="action" 
            href="{{ url_for('generator.edit', id=town['id']) }}">
            {{font_awesome.render_icon("fa-solid fa-wrench")}}
          </a>
          <a class="action" 
            href="{{ url_for('generator.delete', id=town['id']) }}"  
            onclick="return confirm('Are you sure you want to delete this?');">
            {{font_awesome.render_icon("fa-solid fa-trash-can")}}
          </a>
      </header>
      <p class="body">{{ town }}</p>
    </article>
    {% if not loop.last %}
      <hr>
    {% endif %}
  {% endfor %}
{% endblock %}
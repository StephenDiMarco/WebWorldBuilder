{% extends 'base.jinja' %}

{% block header %}
  <h1>{% block title %}Towns{% endblock %}</h1>
  {% if g.user %}
    <a class="action" href="{{ url_for('blog.create') }}">New</a>
  {% endif %}
{% endblock %}

{% block content %}
  {% for town in towns %}
    <article>
       <header>
          <h1>{{ town['name'] }}</h1>
      </header>
      <p class="body">Town details to come</p>
    </article>
    {% if not loop.last %}
      <hr>
    {% endif %}
  {% endfor %}
{% endblock %}